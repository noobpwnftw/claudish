+        TF_SELECTION selection;
+        ULONG fetched = 0;
+        if (session->context()->GetSelection(cookie, TF_DEFAULT_SELECTION, 1, &selection, &fetched) != S_OK || fetched == 0) {
+            return false;
+        }
+        ITfRange* range = selection.range;
+        anchor = ComPtr<ITfRange>::takeover(std::move(range));
+        if (selected != nullptr) {  // the selection itself, when nothing is composed
+            auto buf = std::make_unique<wchar_t[]>(size_t(limit) + 1);
+            ULONG got = 0;
+            if (anchor->GetText(cookie, 0, buf.get(), ULONG(limit), &got) == S_OK) {
+                selected->assign(buf.get(), got);
+            }
+        }
+    }
+    auto read = [&](bool backward, std::wstring& out) {
+        ComPtr<ITfRange> range;
+        if (anchor->Clone(&range) != S_OK || !range) {
+            return;
+        }
+        LONG moved = 0;
+        if (backward) {
+            range->Collapse(cookie, TF_ANCHOR_START);
+            range->ShiftStart(cookie, -limit, &moved, nullptr);
+        }
+        else {
+            range->Collapse(cookie, TF_ANCHOR_END);
+            range->ShiftEnd(cookie, limit, &moved, nullptr);
+        }
+        auto buf = std::make_unique<wchar_t[]>(size_t(limit) + 1);
+        ULONG got = 0;
+        if (range->GetText(cookie, 0, buf.get(), ULONG(limit), &got) == S_OK) {
+            out.assign(buf.get(), got);
+        }
+    };
+    read(true, before);
+    read(false, after);
+    return true;
+}
+
+// GUID_PROP_INPUTSCOPE: declared by msctf.h, defined in no library PIME links.
+static const GUID kInputScopeProperty = {0x1713dd5a, 0x68e7, 0x4a5b, {0x9a, 0xf6, 0x59, 0x2a, 0x59, 0x5c, 0x77, 0x8d}};
+
+std::vector<int> TextService::inputScopes(EditSession* session) const {
+    std::vector<int> result;
+    TfEditCookie cookie = session->editCookie();
+    TF_SELECTION selection;
+    ULONG fetched = 0;
+    if (session->context()->GetSelection(cookie, TF_DEFAULT_SELECTION, 1, &selection, &fetched) != S_OK || fetched == 0) {
+        return result;
+    }
+    ITfRange* raw = selection.range;
+    auto range = ComPtr<ITfRange>::takeover(std::move(raw));
+    ComPtr<ITfReadOnlyProperty> property;
+    if (session->context()->GetAppProperty(kInputScopeProperty, &property) != S_OK || !property) {
+        return result;
+    }
+    VARIANT value;
+    VariantInit(&value);
+    if (property->GetValue(cookie, range, &value) == S_OK && value.vt == VT_UNKNOWN && value.punkVal) {
+        if (auto scope = ComPtr<ITfInputScope>::queryFrom(value.punkVal)) {
+            InputScope* scopes = nullptr;
+            UINT count = 0;
+            if (scope->GetInputScopes(&scopes, &count) == S_OK && scopes) {
+                result.assign(scopes, scopes + count);
+                CoTaskMemFree(scopes);
+            }
+        }
+    }
+    VariantClear(&value);
+    return result;
+}
