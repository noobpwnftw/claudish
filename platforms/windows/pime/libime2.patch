diff --git a/src/Style.h b/src/Style.h
new file mode 100644
index 0000000..807d8e3
--- /dev/null
+++ b/src/Style.h
@@ -0,0 +1,108 @@
+//
+//    Claudish: the look of the candidate and message windows, after Windows 11's own popups
+//    (a rounded corner, the system shadow, the app theme's colours). Header-only, LGPL like
+//    the rest of libIME2.
+//
+
+#ifndef IME_STYLE_H
+#define IME_STYLE_H
+
+#include <windows.h>
+#include <string>
+
+namespace Ime {
+
+struct Palette {
+    COLORREF background;
+    COLORREF text;
+    COLORREF muted;      // selection keys, the header, the footer
+    COLORREF selection;  // the highlighted row
+    COLORREF accent;     // the small bar on the highlighted row
+};
+
+// The apps' theme (Settings > Personalization > Colors), which is what the app under the caret uses.
+inline bool appsUseDarkTheme() {
+    DWORD value = 1, size = sizeof(value);
+    if (::RegGetValueW(HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
+                       L"AppsUseLightTheme", RRF_RT_REG_DWORD, NULL, &value, &size) != ERROR_SUCCESS)
+        return false;
+    return value == 0;
+}
+
+inline Palette currentPalette() {
+    if (appsUseDarkTheme())
+        return { RGB(44, 44, 44), RGB(255, 255, 255), RGB(160, 160, 160), RGB(64, 64, 64), RGB(230, 140, 110) };
+    return { RGB(249, 249, 249), RGB(26, 26, 26), RGB(112, 112, 112), RGB(232, 232, 232), RGB(217, 119, 87) };
+}
+
+// Pixels at 96 DPI to device pixels (the system DPI, as the candidate font's size is computed).
+inline int scaled(int pixels) {
+    static int dpi = 0;
+    if (!dpi) {
+        HDC dc = ::GetDC(NULL);
+        dpi = dc ? ::GetDeviceCaps(dc, LOGPIXELSY) : 96;
+        if (dc)
+            ::ReleaseDC(NULL, dc);
+    }
+    return ::MulDiv(pixels, dpi, 96);
+}
+
+// Windows 11 rounds the window's corners and draws its border and shadow (menus' small radius);
+// earlier versions ignore it and keep a square window with the class's drop shadow.
+inline void roundCorners(HWND hwnd) {
+    typedef HRESULT (WINAPI *SetAttribute)(HWND, DWORD, LPCVOID, DWORD);
+    static HMODULE dwm = ::LoadLibraryW(L"dwmapi.dll");
+    if (!dwm)
+        return;
+    SetAttribute set = (SetAttribute)::GetProcAddress(dwm, "DwmSetWindowAttribute");
+    if (!set)
+        return;
+    const DWORD DWMWA_WINDOW_CORNER_PREFERENCE = 33, DWMWCP_ROUNDSMALL = 3;
+    DWORD preference = DWMWCP_ROUNDSMALL;
+    set(hwnd, DWMWA_WINDOW_CORNER_PREFERENCE, &preference, sizeof(preference));
+}
+
+// A font like `base`, `percent` of its size, in the given weight.
+inline HFONT derivedFont(HFONT base, int percent, int weight) {
+    LOGFONTW lf;
+    if (!base || !::GetObjectW(base, sizeof(lf), &lf))
+        return NULL;
+    lf.lfHeight = ::MulDiv(lf.lfHeight, percent, 100);
+    lf.lfWeight = weight;
+    lf.lfQuality = CLEARTYPE_QUALITY;
+    return ::CreateFontIndirectW(&lf);
+}
+
+inline void fillRect(HDC dc, const RECT& rc, COLORREF color) {
+    HBRUSH brush = ::CreateSolidBrush(color);
+    ::FillRect(dc, &rc, brush);
+    ::DeleteObject(brush);
+}
+
+inline void fillRoundRect(HDC dc, const RECT& rc, int radius, COLORREF color) {
+    HBRUSH brush = ::CreateSolidBrush(color);
+    HGDIOBJ oldBrush = ::SelectObject(dc, brush);
+    HGDIOBJ oldPen = ::SelectObject(dc, ::GetStockObject(NULL_PEN));
+    ::RoundRect(dc, rc.left, rc.top, rc.right + 1, rc.bottom + 1, radius * 2, radius * 2);
+    ::SelectObject(dc, oldPen);
+    ::SelectObject(dc, oldBrush);
+    ::DeleteObject(brush);
+}
+
+// The height of `text` wrapped to `width` in the font selected into `dc`.
+inline int wrappedHeight(HDC dc, const std::wstring& text, int width, int* used = NULL) {
+    RECT rc = { 0, 0, width, 0 };
+    ::DrawTextW(dc, text.c_str(), (int)text.length(), &rc, DT_CALCRECT | DT_WORDBREAK | DT_NOPREFIX);
+    if (used)
+        *used = rc.right;
+    return rc.bottom;
+}
+
+inline void drawWrapped(HDC dc, const std::wstring& text, RECT rc, COLORREF color) {
+    ::SetTextColor(dc, color);
+    ::DrawTextW(dc, text.c_str(), (int)text.length(), &rc, DT_WORDBREAK | DT_NOPREFIX);
+}
+
+} // namespace Ime
+
+#endif
