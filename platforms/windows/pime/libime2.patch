diff --git a/src/Panel.cpp b/src/Panel.cpp
new file mode 100644
index 0000000..3695b05
--- /dev/null
+++ b/src/Panel.cpp
@@ -0,0 +1,433 @@
+//
+//    Claudish: the panel and the suggestion, painted with Direct2D and DirectWrite to the design
+//    lab's Windows 11 mock (claudish/web/design.html#windows; docs/design/visual.md).
+//
+
+#include "Panel.h"
+#include "Style.h"
+
+#include <algorithm>
+#include <cmath>
+
+#pragma comment(lib, "d2d1.lib")
+#pragma comment(lib, "dwrite.lib")
+
+namespace Ime {
+
+// The skin's geometry in pixels at 96 DPI (design.css, .host.windows).
+static const float PAD = 4, ROW_X = 10, ROW_Y = 5, NUMBER = 12, NUMBER_GAP = 10, TAKE = 48, HEAD_GAP = 2;
+static const float FONT = 14, SMALL = 12, MONO = 13, MIN_WIDTH = 240, MAX_WIDTH = 440, ROW_RADIUS = 4;
+static const float TILE = 18, CAP_X = 5, CAP_H = 18, KEY_GAP = 5, ITEM_GAP = 12;
+
+static ID2D1Factory* d2d = nullptr;
+static IDWriteFactory* dwrite = nullptr;
+
+template <class T> static void releaseOne(T*& p) {
+    if (p) {
+        p->Release();
+        p = nullptr;
+    }
+}
+
+static D2D1_COLOR_F color(COLORREF c, float alpha = 1.0f) {
+    return D2D1::ColorF(GetRValue(c) / 255.0f, GetGValue(c) / 255.0f, GetBValue(c) / 255.0f, alpha);
+}
+
+// Segoe UI Variable on Windows 11; Segoe UI where it is missing.
+static const wchar_t* uiFont() {
+    static const wchar_t* chosen = nullptr;
+    if (!chosen) {
+        chosen = L"Segoe UI";
+        IDWriteFontCollection* fonts = nullptr;
+        if (dwrite && SUCCEEDED(dwrite->GetSystemFontCollection(&fonts, FALSE))) {
+            UINT32 index = 0;
+            BOOL exists = FALSE;
+            if (SUCCEEDED(fonts->FindFamilyName(L"Segoe UI Variable Text", &index, &exists)) && exists)
+                chosen = L"Segoe UI Variable Text";
+            fonts->Release();
+        }
+    }
+    return chosen;
+}
+
+PanelPainter::PanelPainter() {
+    scale_ = scaled(1000) / 1000.0f;
+}
+
+PanelPainter::~PanelPainter() {
+    release();
+    releaseOne(text_);
+    releaseOne(small_);
+    releaseOne(label_format_);
+    releaseOne(mono_);
+    releaseOne(tile_);
+}
+
+bool PanelPainter::ensureFactories() {
+    if (!d2d && FAILED(D2D1CreateFactory(D2D1_FACTORY_TYPE_SINGLE_THREADED, &d2d)))
+        return false;
+    if (!dwrite && FAILED(DWriteCreateFactory(DWRITE_FACTORY_TYPE_SHARED, __uuidof(IDWriteFactory),
+                                              reinterpret_cast<IUnknown**>(&dwrite))))
+        return false;
+    if (!text_) {
+        const wchar_t* ui = uiFont();
+        dwrite->CreateTextFormat(ui, nullptr, DWRITE_FONT_WEIGHT_NORMAL, DWRITE_FONT_STYLE_NORMAL,
+                                 DWRITE_FONT_STRETCH_NORMAL, px(FONT), L"", &text_);
+        dwrite->CreateTextFormat(ui, nullptr, DWRITE_FONT_WEIGHT_NORMAL, DWRITE_FONT_STYLE_NORMAL,
+                                 DWRITE_FONT_STRETCH_NORMAL, px(SMALL), L"", &small_);
+        dwrite->CreateTextFormat(ui, nullptr, DWRITE_FONT_WEIGHT_SEMI_BOLD, DWRITE_FONT_STYLE_NORMAL,
+                                 DWRITE_FONT_STRETCH_NORMAL, px(SMALL), L"", &label_format_);
+        dwrite->CreateTextFormat(L"Cascadia Mono", nullptr, DWRITE_FONT_WEIGHT_NORMAL, DWRITE_FONT_STYLE_NORMAL,
+                                 DWRITE_FONT_STRETCH_NORMAL, px(MONO), L"", &mono_);
+        dwrite->CreateTextFormat(L"Consolas", nullptr, DWRITE_FONT_WEIGHT_BOLD, DWRITE_FONT_STYLE_NORMAL,
+                                 DWRITE_FONT_STRETCH_NORMAL, px(10), L"", &tile_);
+    }
+    return text_ && small_ && label_format_ && mono_ && tile_;
+}
+
+IDWriteTextLayout* PanelPainter::makeLayout(const std::wstring& text, IDWriteTextFormat* format, float maxWidth) {
+    IDWriteTextLayout* layout = nullptr;
+    dwrite->CreateTextLayout(text.c_str(), (UINT32)text.size(), format, maxWidth, 10000.0f, &layout);
+    return layout;
+}
+
+static void measure(IDWriteTextLayout* layout, float* w, float* h) {
+    DWRITE_TEXT_METRICS m = {};
+    if (layout)
+        layout->GetMetrics(&m);
+    *w = std::ceil(m.widthIncludingTrailingWhitespace);
+    *h = std::ceil(m.height);
+}
+
+void PanelPainter::release() {
+    releaseOne(label_.layout);
+    releaseOne(body_.layout);
+    for (auto& line : rows_)
+        releaseOne(line.layout);
+    for (auto& line : numbers_)
+        releaseOne(line.layout);
+    for (auto& item : foot_)
+        releaseOne(item.layout);
+    releaseOne(take_);
+    rows_.clear();
+    numbers_.clear();
+    rowTop_.clear();
+    rowHeight_.clear();
+    foot_.clear();
+}
+
+int PanelPainter::textInset() const {
+    return (int)(px(PAD) + px(ROW_X) + (spec_.rows.empty() ? 0 : px(NUMBER) + px(NUMBER_GAP)));
+}
+
+SIZE PanelPainter::layout(const PanelSpec& spec) {
+    release();
+    spec_ = spec;
+    SIZE none = { 0, 0 };
+    if (spec.empty() || !ensureFactories())
+        return none;
+    const float inner = px(MAX_WIDTH) - 2 * px(PAD) - 2 * px(ROW_X);
+    float widest = (spec.rows.empty() && spec.body.empty()) ? 0 : px(MIN_WIDTH);
+    float y = px(PAD);
+    // The header: a small label, then the content as is.
+    if (!spec.body.empty()) {
+        y += px(ROW_Y) + 1;
+        if (!spec.label.empty()) {
+            label_.layout = makeLayout(spec.label, label_format_, inner);
+            measure(label_.layout, &label_.w, &label_.h);
+            label_.x = px(PAD) + px(ROW_X);
+            label_.y = y;
+            y += label_.h + px(HEAD_GAP);
+            widest = (std::max)(widest, label_.w + 2 * (px(PAD) + px(ROW_X)));
+        }
+        body_.layout = makeLayout(spec.body, spec.code ? mono_ : text_, inner);
+        measure(body_.layout, &body_.w, &body_.h);
+        body_.x = px(PAD) + px(ROW_X);
+        body_.y = y;
+        y += body_.h + px(ROW_Y);
+        widest = (std::max)(widest, body_.w + 2 * (px(PAD) + px(ROW_X)));
+    }
+    // The rows: a number, the text (its legend muted); a list with a highlight keeps a trailing
+    // column on every row for the highlighted row's Enter, so every row wraps alike.
+    const bool takes = spec.on >= 0 && spec.on < (int)spec.rows.size();
+    const float textX = px(PAD) + px(ROW_X) + px(NUMBER) + px(NUMBER_GAP);
+    const float textMax = inner - px(NUMBER) - px(NUMBER_GAP) - (takes ? px(TAKE) : 0);
+    for (size_t i = 0; i < spec.rows.size(); ++i) {
+        const PanelRow& row = spec.rows[i];
+        std::wstring words = row.text + (row.legend.empty() ? L"" : L" — " + row.legend);
+        Line line, number;
+        line.layout = makeLayout(words, text_, textMax);
+        measure(line.layout, &line.w, &line.h);
+        number.layout = makeLayout(row.key, text_, px(NUMBER) + 4);
+        measure(number.layout, &number.w, &number.h);
+        float h = (std::max)(line.h, px(18)) + 2 * px(ROW_Y);
+        rowTop_.push_back(y);
+        rowHeight_.push_back(h);
+        line.x = textX;
+        line.y = y + px(ROW_Y);
+        number.x = px(PAD) + px(ROW_X);
+        number.y = y + px(ROW_Y);
+        rows_.push_back(line);
+        numbers_.push_back(number);
+        widest = (std::max)(widest, textX + line.w + (takes ? px(TAKE) : 0) + px(ROW_X) + px(PAD));
+        y += h;
+    }
+    if (takes)
+        take_ = makeLayout(L"Enter", small_, 200);
+    // The footer: the AI tile (or a warning mark), what is happening, each key with its verb, the
+    // free words, and a hosted model's name at the end.
+    if (!spec.rows.empty() || !spec.body.empty())
+        y += px(2);
+    footTop_ = y;
+    footHeight_ = px(20) + 2 * px(ROW_Y) - 1;
+    float x = px(PAD) + px(ROW_X);
+    auto add = [&](FootItem::Kind kind, const std::wstring& text, IDWriteTextFormat* format, float gap) {
+        FootItem item;
+        item.kind = kind;
+        item.text = text;
+        if (kind == FootItem::Tile || kind == FootItem::Warn) {
+            item.w = item.h = px(TILE);
+        } else if (kind == FootItem::Spinner) {
+            item.w = item.h = px(12);
+        } else {
+            item.layout = makeLayout(text, format, 1000);
+            measure(item.layout, &item.w, &item.h);
+            if (kind == FootItem::Cap)
+                item.w += 2 * px(CAP_X);
+        }
+        item.x = x;
+        x += item.w + gap;
+        foot_.push_back(item);
+    };
+    add(spec.tile == L"warn" ? FootItem::Warn : FootItem::Tile, spec.tile == L"cd" ? L"cd" : L"AI", nullptr, px(8));
+    if (!spec.status.empty()) {
+        if (spec.busy)
+            add(FootItem::Spinner, L"", nullptr, px(6));
+        add(FootItem::Text, spec.status, small_, px(ITEM_GAP));
+    }
+    if (!spec.failed.empty())
+        add(FootItem::Error, spec.failed, small_, px(ITEM_GAP));
+    for (const auto& key : spec.foot) {
+        add(FootItem::Cap, key.first, small_, px(KEY_GAP));
+        add(FootItem::Verb, key.second, small_, px(ITEM_GAP));
+    }
+    if (!spec.tail.empty())
+        add(FootItem::Verb, spec.tail, small_, px(ITEM_GAP));
+    if (!spec.mark.empty())
+        add(FootItem::Mark, spec.mark, small_, 0);
+    widest = (std::max)(widest, x - px(ITEM_GAP) + px(ROW_X) + px(PAD));
+    y += footHeight_ + px(PAD);
+    width_ = (std::min)(px(MAX_WIDTH), widest);
+    height_ = y;
+    if (!foot_.empty() && foot_.back().kind == FootItem::Mark)  // the hosted mark, at the end
+        foot_.back().x = (std::max)(foot_.back().x, width_ - px(PAD) - px(ROW_X) - foot_.back().w);
+    SIZE size = { (LONG)std::ceil(width_), (LONG)std::ceil(height_) };
+    return size;
+}
+
+void PanelPainter::paint(HDC dc, const RECT& rc, float spin) {
+    if (spec_.empty() || !ensureFactories())
+        return;
+    D2D1_RENDER_TARGET_PROPERTIES props = D2D1::RenderTargetProperties(
+        D2D1_RENDER_TARGET_TYPE_DEFAULT, D2D1::PixelFormat(DXGI_FORMAT_B8G8R8A8_UNORM, D2D1_ALPHA_MODE_IGNORE), 96, 96);
+    ID2D1DCRenderTarget* target = nullptr;
+    if (FAILED(d2d->CreateDCRenderTarget(&props, &target)) || FAILED(target->BindDC(dc, &rc))) {
+        releaseOne(target);
+        return;
+    }
+    Palette colors = currentPalette();
+    ID2D1SolidColorBrush *brush = nullptr, *muted = nullptr;
+    target->CreateSolidColorBrush(color(colors.text), &brush);
+    target->CreateSolidColorBrush(color(colors.muted), &muted);
+    auto fill = [&](const D2D1_RECT_F& r, float radius, COLORREF c) {
+        ID2D1SolidColorBrush* b = nullptr;
+        target->CreateSolidColorBrush(color(c), &b);
+        target->FillRoundedRectangle(D2D1::RoundedRect(r, radius, radius), b);
+        b->Release();
+    };
+    auto text = [&](IDWriteTextLayout* layout, float x, float y, ID2D1Brush* b) {
+        if (layout)
+            target->DrawTextLayout(D2D1::Point2F(x, y), layout, b, D2D1_DRAW_TEXT_OPTIONS_ENABLE_COLOR_FONT);
+    };
+
+    target->BeginDraw();
+    target->Clear(color(colors.surface));
+    text(label_.layout, label_.x, label_.y, muted);
+    text(body_.layout, body_.x, body_.y, brush);
+    for (size_t i = 0; i < rows_.size(); ++i) {
+        const bool on = (int)i == spec_.on;
+        const float top = rowTop_[i], h = rowHeight_[i];
+        if (on) {  // a neutral fill, the system accent bar inside it, and the row's own Enter
+            fill(D2D1::RectF(px(PAD), top, width_ - px(PAD), top + h), px(ROW_RADIUS), colors.selection);
+            fill(D2D1::RectF(px(PAD) + px(2), top + px(7), px(PAD) + px(5), top + h - px(7)), px(1.5f), colors.accent);
+            if (take_) {
+                float w, th;
+                measure(take_, &w, &th);
+                float capW = w + 2 * px(CAP_X), x = width_ - px(PAD) - px(ROW_X) - capW, y = top + (h - px(CAP_H)) / 2;
+                ID2D1SolidColorBrush* edge = nullptr;
+                target->CreateSolidColorBrush(color(colors.contrast ? colors.accent : colors.cap), &edge);
+                target->DrawRoundedRectangle(D2D1::RoundedRect(D2D1::RectF(x + 0.5f, y + 0.5f, x + capW - 0.5f,
+                                                                           y + px(CAP_H) - 0.5f), px(4), px(4)), edge);
+                edge->Release();
+                text(take_, x + px(CAP_X), y + (px(CAP_H) - th) / 2, colors.contrast ? brush : brush);
+            }
+        }
+        ID2D1SolidColorBrush* ink = brush;
+        ID2D1SolidColorBrush* inverse = nullptr;
+        if (on && colors.contrast) {  // high contrast: the highlight's own text colour
+            target->CreateSolidColorBrush(color(colors.accent), &inverse);
+            ink = inverse;
+        }
+        text(numbers_[i].layout, numbers_[i].x, numbers_[i].y, on ? ink : muted);
+        const PanelRow& row = spec_.rows[i];
+        if (!row.legend.empty() && rows_[i].layout) {  // the legend in the muted colour
+            DWRITE_TEXT_RANGE range = { (UINT32)row.text.size(), (UINT32)(row.legend.size() + 3) };
+            rows_[i].layout->SetDrawingEffect(on && colors.contrast ? (IUnknown*)ink : (IUnknown*)muted, range);
+        }
+        text(rows_[i].layout, rows_[i].x, rows_[i].y, ink);
+        releaseOne(inverse);
+    }
+    // The footer.
+    const float mid = footTop_ + footHeight_ / 2;
+    for (const FootItem& item : foot_) {
+        switch (item.kind) {
+        case FootItem::Tile: {
+            D2D1_RECT_F r = D2D1::RectF(item.x, mid - item.h / 2, item.x + item.w, mid + item.h / 2);
+            const bool ai = item.text == L"AI";  // continue's tile is neutral: only compose wears the accent
+            fill(r, px(4), ai ? colors.tile : mix(colors.surface, colors.text, 12));
+            IDWriteTextLayout* glyph = makeLayout(item.text, tile_, item.w);
+            float w, h;
+            measure(glyph, &w, &h);
+            ID2D1SolidColorBrush* ink = nullptr;
+            target->CreateSolidColorBrush(ai ? D2D1::ColorF(1, 1, 1) : color(colors.text), &ink);
+            text(glyph, item.x + (item.w - w) / 2, mid - h / 2, ink);
+            ink->Release();
+            releaseOne(glyph);
+            break;
+        }
+        case FootItem::Warn: {  // a failure reads without colour: a mark, then why
+            ID2D1SolidColorBrush* red = nullptr;
+            target->CreateSolidColorBrush(color(colors.error), &red);
+            target->FillEllipse(D2D1::Ellipse(D2D1::Point2F(item.x + item.w / 2, mid), item.w / 2, item.w / 2), red);
+            red->Release();
+            IDWriteTextLayout* mark = makeLayout(L"!", label_format_, item.w);
+            float w, h;
+            measure(mark, &w, &h);
+            ID2D1SolidColorBrush* surface = nullptr;
+            target->CreateSolidColorBrush(color(colors.surface), &surface);
+            text(mark, item.x + (item.w - w) / 2, mid - h / 2, surface);
+            surface->Release();
+            releaseOne(mark);
+            break;
+        }
+        case FootItem::Spinner: {  // a ring with a turning arc
+            const float r = item.w / 2 - px(1), cx = item.x + item.w / 2;
+            ID2D1SolidColorBrush* faint = nullptr;
+            target->CreateSolidColorBrush(color(colors.muted, 0.35f), &faint);
+            target->DrawEllipse(D2D1::Ellipse(D2D1::Point2F(cx, mid), r, r), faint, px(1.5f));
+            faint->Release();
+            ID2D1PathGeometry* arc = nullptr;
+            if (SUCCEEDED(d2d->CreatePathGeometry(&arc))) {
+                ID2D1GeometrySink* sink = nullptr;
+                arc->Open(&sink);
+                const float a0 = spin, a1 = spin + 1.6f;
+                sink->BeginFigure(D2D1::Point2F(cx + r * std::cos(a0), mid + r * std::sin(a0)), D2D1_FIGURE_BEGIN_HOLLOW);
+                sink->AddArc(D2D1::ArcSegment(D2D1::Point2F(cx + r * std::cos(a1), mid + r * std::sin(a1)),
+                                              D2D1::SizeF(r, r), 0, D2D1_SWEEP_DIRECTION_CLOCKWISE, D2D1_ARC_SIZE_SMALL));
+                sink->EndFigure(D2D1_FIGURE_END_OPEN);
+                sink->Close();
+                sink->Release();
+                target->DrawGeometry(arc, muted, px(1.5f));
+                arc->Release();
+            }
+            break;
+        }
+        case FootItem::Cap: {
+            ID2D1SolidColorBrush* edge = nullptr;
+            target->CreateSolidColorBrush(color(colors.cap), &edge);
+            D2D1_RECT_F r = D2D1::RectF(item.x + 0.5f, mid - px(CAP_H) / 2 + 0.5f, item.x + item.w - 0.5f,
+                                        mid + px(CAP_H) / 2 - 0.5f);
+            target->DrawRoundedRectangle(D2D1::RoundedRect(r, px(4), px(4)), edge);
+            edge->Release();
+            text(item.layout, item.x + px(CAP_X), mid - item.h / 2, brush);
+            break;
+        }
+        case FootItem::Error: {
+            ID2D1SolidColorBrush* red = nullptr;
+            target->CreateSolidColorBrush(color(colors.error), &red);
+            text(item.layout, item.x, mid - item.h / 2, red);
+            red->Release();
+            break;
+        }
+        case FootItem::Text:
+            text(item.layout, item.x, mid - item.h / 2, brush);
+            break;
+        default:  // a verb, the free words, the hosted mark
+            text(item.layout, item.x, mid - item.h / 2, muted);
+        }
+    }
+    target->EndDraw();
+    releaseOne(brush);
+    releaseOne(muted);
+    releaseOne(target);
+}
+
+void GhostPainter::show(HWND hwnd, const std::wstring& text, const RECT& caret) {
+    if (!d2d && FAILED(D2D1CreateFactory(D2D1_FACTORY_TYPE_SINGLE_THREADED, &d2d)))
+        return;
+    if (!dwrite && FAILED(DWriteCreateFactory(DWRITE_FACTORY_TYPE_SHARED, __uuidof(IDWriteFactory),
+                                              reinterpret_cast<IUnknown**>(&dwrite))))
+        return;
+    // The UI font at the caret's height (the line is about 1.25 times the font's size).
+    const float size = (std::max)(11.0f * scaled(1000) / 1000.0f, (caret.bottom - caret.top) / 1.25f);
+    IDWriteTextFormat* format = nullptr;
+    dwrite->CreateTextFormat(uiFont(), nullptr, DWRITE_FONT_WEIGHT_NORMAL, DWRITE_FONT_STYLE_NORMAL,
+                             DWRITE_FONT_STRETCH_NORMAL, size, L"", &format);
+    if (!format)
+        return;
+    IDWriteTextLayout* layout = nullptr;
+    dwrite->CreateTextLayout(text.c_str(), (UINT32)text.size(), format, 4000, 1000, &layout);
+    float w, h;
+    measure(layout, &w, &h);
+    const int width = (std::max)(1, (int)w + 2), height = (std::max)(1, (int)h);
+    // A premultiplied 32-bit bitmap, painted, then handed to the layered window.
+    BITMAPINFO info = {};
+    info.bmiHeader.biSize = sizeof(info.bmiHeader);
+    info.bmiHeader.biWidth = width;
+    info.bmiHeader.biHeight = -height;
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    void* bits = nullptr;
+    HDC screen = GetDC(nullptr);
+    HDC memory = CreateCompatibleDC(screen);
+    HBITMAP bitmap = CreateDIBSection(memory, &info, DIB_RGB_COLORS, &bits, nullptr, 0);
+    HGDIOBJ old = SelectObject(memory, bitmap);
+    D2D1_RENDER_TARGET_PROPERTIES props = D2D1::RenderTargetProperties(
+        D2D1_RENDER_TARGET_TYPE_DEFAULT, D2D1::PixelFormat(DXGI_FORMAT_B8G8R8A8_UNORM, D2D1_ALPHA_MODE_PREMULTIPLIED), 96, 96);
+    ID2D1DCRenderTarget* target = nullptr;
+    RECT area = { 0, 0, width, height };
+    if (SUCCEEDED(d2d->CreateDCRenderTarget(&props, &target)) && SUCCEEDED(target->BindDC(memory, &area))) {
+        ID2D1SolidColorBrush* grey = nullptr;
+        target->CreateSolidColorBrush(color(currentPalette().ghost), &grey);
+        target->SetTextAntialiasMode(D2D1_TEXT_ANTIALIAS_MODE_GRAYSCALE);  // ClearType needs an opaque background
+        target->BeginDraw();
+        target->Clear(D2D1::ColorF(0, 0, 0, 0));
+        target->DrawTextLayout(D2D1::Point2F(1, 0), layout, grey);
+        target->EndDraw();
+        grey->Release();
+    }
+    releaseOne(target);
+    POINT at = { caret.right, caret.top + ((caret.bottom - caret.top) - height) / 2 }, origin = { 0, 0 };
+    SIZE extent = { width, height };
+    BLENDFUNCTION blend = { AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
+    UpdateLayeredWindow(hwnd, screen, &at, &extent, memory, &origin, 0, &blend, ULW_ALPHA);
+    SetWindowPos(hwnd, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE | SWP_SHOWWINDOW);
+    SelectObject(memory, old);
+    DeleteObject(bitmap);
+    DeleteDC(memory);
+    ReleaseDC(nullptr, screen);
+    releaseOne(layout);
+    releaseOne(format);
+}
+
+} // namespace Ime
diff --git a/src/Panel.h b/src/Panel.h
new file mode 100644
index 0000000..984347d
--- /dev/null
+++ b/src/Panel.h
@@ -0,0 +1,125 @@
+//
+//    Claudish: the panel next to the caret, as the design lab draws it (claudish/web/design.html,
+//    Windows 11 skin; docs/design/visual.md), painted with Direct2D and DirectWrite (GDI cannot
+//    anti-alias the rounded keycaps and tile, nor draw Segoe UI Variable well). LGPL like the rest
+//    of libIME2.
+//
+
+#ifndef IME_PANEL_H
+#define IME_PANEL_H
+
+#include "Window.h"
+#include <windows.h>
+#include <d2d1.h>
+#include <dwrite.h>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace Ime {
+
+// What the panel shows: Claudish's Composition.panel(), sent by the input method as JSON.
+struct PanelRow {
+    std::wstring key;
+    std::wstring text;
+    std::wstring legend;
+};
+
+struct PanelSpec {
+    std::wstring label;   // the header: who asks or what this is (small)
+    std::wstring body;    // then the content as is
+    bool code = false;    // the body is a command (monospace)
+    std::vector<PanelRow> rows;
+    int on = -1;          // the highlighted row; -1: none (an approval)
+    std::vector<std::pair<std::wstring, std::wstring>> foot;  // (key, verb)
+    std::wstring tail;    // free words after the keys ("or type a reply")
+    std::wstring tile = L"ai";  // "ai", or "warn" when a request failed
+    std::wstring status;  // what is happening
+    bool busy = false;    // with a spinner
+    std::wstring failed;  // why a request failed
+    std::wstring mark;    // a hosted model's name, at the footer's end
+
+    bool empty() const {
+        return body.empty() && rows.empty() && foot.empty() && status.empty() && failed.empty();
+    }
+};
+
+// Lays out and paints a PanelSpec. Sizes are device pixels (the system DPI).
+class PanelPainter {
+public:
+    PanelPainter();
+    ~PanelPainter();
+
+    // The panel's size for this spec; keeps the layout for paint().
+    SIZE layout(const PanelSpec& spec);
+    // Paints the last layout into the DC (the window's client area); spin: the spinner's angle.
+    void paint(HDC dc, const RECT& rc, float spin);
+    // The x of the rows' text, from the panel's left edge: the window is placed so that it lines up
+    // with the composition's first character.
+    int textInset() const;
+
+private:
+    struct Line {
+        IDWriteTextLayout* layout = nullptr;
+        float x = 0, y = 0, w = 0, h = 0;
+    };
+    struct FootItem {
+        enum Kind { Tile, Warn, Spinner, Text, Error, Cap, Verb, Mark } kind;
+        std::wstring text;
+        IDWriteTextLayout* layout = nullptr;
+        float x = 0, w = 0, h = 0;
+    };
+
+    bool ensureFactories();
+    IDWriteTextLayout* makeLayout(const std::wstring& text, IDWriteTextFormat* format, float maxWidth);
+    void release();
+    float px(float dips) const { return dips * scale_; }
+
+    PanelSpec spec_;
+    float scale_ = 1.0f;
+    float width_ = 0, height_ = 0;
+    Line label_, body_;
+    std::vector<Line> rows_;      // the rows' text
+    std::vector<Line> numbers_;
+    std::vector<float> rowTop_, rowHeight_;
+    std::vector<FootItem> foot_;
+    float footTop_ = 0, footHeight_ = 0;
+    IDWriteTextLayout* take_ = nullptr;  // the highlighted row's "Enter"
+
+    IDWriteTextFormat* text_ = nullptr;
+    IDWriteTextFormat* small_ = nullptr;
+    IDWriteTextFormat* label_format_ = nullptr;
+    IDWriteTextFormat* mono_ = nullptr;
+    IDWriteTextFormat* tile_ = nullptr;
+};
+
+// Continue's suggestion: cd_AI's own grey text right after the caret, in the UI font at the
+// caret's height, on a transparent layered window that never takes the mouse or the keyboard.
+class GhostPainter {
+public:
+    // Paints text into a layered window placed at the caret rectangle's right end.
+    static void show(HWND hwnd, const std::wstring& text, const RECT& caret);
+};
+
+class GhostWindow : public Window {
+public:
+    explicit GhostWindow(HWND parent) {
+        create(parent, WS_POPUP, WS_EX_LAYERED | WS_EX_TRANSPARENT | WS_EX_TOOLWINDOW | WS_EX_TOPMOST | WS_EX_NOACTIVATE);
+    }
+    void show(const std::wstring& text, const RECT& caret) {
+        GhostPainter::show(hwnd_, text, caret);
+    }
+
+protected:
+    LRESULT wndProc(UINT msg, WPARAM wp, LPARAM lp) override {
+        if (msg == WM_MOUSEACTIVATE)
+            return MA_NOACTIVATE;
+        if (msg == WM_NCHITTEST)
+            return HTTRANSPARENT;  // the mouse goes to the app underneath
+        return Window::wndProc(msg, wp, lp);
+    }
+};
+
+} // namespace Ime
+
+#endif
diff --git a/src/Style.h b/src/Style.h
new file mode 100644
index 0000000..71b8a55
--- /dev/null
+++ b/src/Style.h
@@ -0,0 +1,147 @@
+//
+//    Claudish: the look of the candidate and message windows, after Windows 11's own popups
+//    (a rounded corner, the system shadow, the app theme's colours). Header-only, LGPL like
+//    the rest of libIME2.
+//
+
+#ifndef IME_STYLE_H
+#define IME_STYLE_H
+
+#include <windows.h>
+#include <string>
+
+namespace Ime {
+
+// The Windows 11 skin's tokens (claudish/web/design.css, .host.windows): light and dark, the
+// system accent for the highlighted row's bar, and high contrast's system colours.
+struct Palette {
+    COLORREF surface;
+    COLORREF text;
+    COLORREF muted;      // numbers, labels, the footer's words (4.5:1 or more on the surface)
+    COLORREF ghost;      // continue's suggestion (3:1 or more)
+    COLORREF selection;  // the highlighted row's neutral fill
+    COLORREF accent;     // its bar: the system accent
+    COLORREF error;
+    COLORREF cap;        // a keycap's border
+    COLORREF tile;       // the AI tile: Claudish's own colour, the one place it appears
+    bool contrast;       // high contrast: system colours, no fills but the highlight
+};
+
+// The apps' theme (Settings > Personalization > Colors), which is what the app under the caret uses.
+inline bool appsUseDarkTheme() {
+    DWORD value = 1, size = sizeof(value);
+    if (::RegGetValueW(HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
+                       L"AppsUseLightTheme", RRF_RT_REG_DWORD, NULL, &value, &size) != ERROR_SUCCESS)
+        return false;
+    return value == 0;
+}
+
+inline COLORREF mix(COLORREF a, COLORREF b, int percentOfB) {
+    return RGB((GetRValue(a) * (100 - percentOfB) + GetRValue(b) * percentOfB) / 100,
+               (GetGValue(a) * (100 - percentOfB) + GetGValue(b) * percentOfB) / 100,
+               (GetBValue(a) * (100 - percentOfB) + GetBValue(b) * percentOfB) / 100);
+}
+
+// The accent colour the user chose (DWM keeps it as 0xAABBGGRR); Windows 11's default blue if none.
+inline COLORREF systemAccent(bool dark) {
+    DWORD value = 0, size = sizeof(value);
+    if (::RegGetValueW(HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\DWM", L"AccentColor",
+                       RRF_RT_REG_DWORD, NULL, &value, &size) != ERROR_SUCCESS)
+        return dark ? RGB(0x60, 0xcd, 0xff) : RGB(0x00, 0x5f, 0xb8);
+    COLORREF accent = value & 0xffffff;  // already 0x00BBGGRR, a COLORREF
+    return dark ? mix(accent, RGB(255, 255, 255), 45) : accent;  // as Windows lightens it on dark
+}
+
+inline bool highContrast() {
+    HIGHCONTRASTW contrast = { sizeof(contrast) };
+    return ::SystemParametersInfoW(SPI_GETHIGHCONTRAST, sizeof(contrast), &contrast, 0)
+        && (contrast.dwFlags & HCF_HIGHCONTRASTON);
+}
+
+inline Palette currentPalette() {
+    const COLORREF tile = RGB(217, 119, 87);
+    if (highContrast()) {
+        COLORREF window = GetSysColor(COLOR_WINDOW), text = GetSysColor(COLOR_WINDOWTEXT);
+        return { window, text, text, GetSysColor(COLOR_GRAYTEXT), GetSysColor(COLOR_HIGHLIGHT),
+                 GetSysColor(COLOR_HIGHLIGHTTEXT), text, text, tile, true };
+    }
+    if (appsUseDarkTheme())
+        return { RGB(44, 44, 44), RGB(255, 255, 255), RGB(197, 197, 197), RGB(139, 139, 139),
+                 mix(RGB(44, 44, 44), RGB(255, 255, 255), 11), systemAccent(true), RGB(255, 153, 164),
+                 RGB(106, 106, 106), tile, false };
+    return { RGB(249, 249, 249), RGB(26, 26, 26), RGB(92, 92, 92), RGB(134, 134, 134),
+             mix(RGB(249, 249, 249), RGB(26, 26, 26), 7), systemAccent(false), RGB(196, 43, 28),
+             RGB(184, 184, 184), tile, false };
+}
+
+// Pixels at 96 DPI to device pixels (the system DPI, as the candidate font's size is computed).
+inline int scaled(int pixels) {
+    static int dpi = 0;
+    if (!dpi) {
+        HDC dc = ::GetDC(NULL);
+        dpi = dc ? ::GetDeviceCaps(dc, LOGPIXELSY) : 96;
+        if (dc)
+            ::ReleaseDC(NULL, dc);
+    }
+    return ::MulDiv(pixels, dpi, 96);
+}
+
+// Windows 11 rounds the window's corners (8 px, as its flyouts) and draws its border and shadow;
+// earlier versions ignore it and keep a square window with the class's drop shadow.
+inline void roundCorners(HWND hwnd) {
+    typedef HRESULT (WINAPI *SetAttribute)(HWND, DWORD, LPCVOID, DWORD);
+    static HMODULE dwm = ::LoadLibraryW(L"dwmapi.dll");
+    if (!dwm)
+        return;
+    SetAttribute set = (SetAttribute)::GetProcAddress(dwm, "DwmSetWindowAttribute");
+    if (!set)
+        return;
+    const DWORD DWMWA_WINDOW_CORNER_PREFERENCE = 33, DWMWCP_ROUND = 2;
+    DWORD preference = DWMWCP_ROUND;
+    set(hwnd, DWMWA_WINDOW_CORNER_PREFERENCE, &preference, sizeof(preference));
+}
+
+// A font like `base`, `percent` of its size, in the given weight.
+inline HFONT derivedFont(HFONT base, int percent, int weight) {
+    LOGFONTW lf;
+    if (!base || !::GetObjectW(base, sizeof(lf), &lf))
+        return NULL;
+    lf.lfHeight = ::MulDiv(lf.lfHeight, percent, 100);
+    lf.lfWeight = weight;
+    lf.lfQuality = CLEARTYPE_QUALITY;
+    return ::CreateFontIndirectW(&lf);
+}
+
+inline void fillRect(HDC dc, const RECT& rc, COLORREF color) {
+    HBRUSH brush = ::CreateSolidBrush(color);
+    ::FillRect(dc, &rc, brush);
+    ::DeleteObject(brush);
+}
+
+inline void fillRoundRect(HDC dc, const RECT& rc, int radius, COLORREF color) {
+    HBRUSH brush = ::CreateSolidBrush(color);
+    HGDIOBJ oldBrush = ::SelectObject(dc, brush);
+    HGDIOBJ oldPen = ::SelectObject(dc, ::GetStockObject(NULL_PEN));
+    ::RoundRect(dc, rc.left, rc.top, rc.right + 1, rc.bottom + 1, radius * 2, radius * 2);
+    ::SelectObject(dc, oldPen);
+    ::SelectObject(dc, oldBrush);
+    ::DeleteObject(brush);
+}
+
+// The height of `text` wrapped to `width` in the font selected into `dc`.
+inline int wrappedHeight(HDC dc, const std::wstring& text, int width, int* used = NULL) {
+    RECT rc = { 0, 0, width, 0 };
+    ::DrawTextW(dc, text.c_str(), (int)text.length(), &rc, DT_CALCRECT | DT_WORDBREAK | DT_NOPREFIX);
+    if (used)
+        *used = rc.right;
+    return rc.bottom;
+}
+
+inline void drawWrapped(HDC dc, const std::wstring& text, RECT rc, COLORREF color) {
+    ::SetTextColor(dc, color);
+    ::DrawTextW(dc, text.c_str(), (int)text.length(), &rc, DT_WORDBREAK | DT_NOPREFIX);
+}
