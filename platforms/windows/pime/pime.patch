+// Claudish: a panel goes under its line, or above it when it does not fit below and there is more
+// room above (as Windows' own IME panels do): never pushed up over the line being typed.
+template <class Panel> static void placePanel(Panel& window, int x, const RECT& line) {
+	int width, height;
+	window.size(&width, &height);
+	const int gap = Ime::scaled(6);
+	int y = line.bottom + gap - window.topInset();
+	MONITORINFO monitor = { sizeof(monitor) };
+	if (::GetMonitorInfo(::MonitorFromRect(&line, MONITOR_DEFAULTTONEAREST), &monitor)) {
+		const RECT& work = monitor.rcWork;
+		if (y + height > work.bottom && line.top - work.top > work.bottom - line.bottom)
+			y = line.top - gap - height + window.bottomInset();
+	}
+	window.move(x, y);
+}
+
+// Claudish: the candidate window opens under its anchor (anchorRect) and stays where it opened while
+// it shows on the same line with the anchor at or right of it (when the text leaves, it follows).
+void TextService::placeCandidates(const RECT& caret) {
+	int x = caret.left - candidateWindow_->textInset();
+	if (candidateWindow_->isVisible() && pinnedLine_ == caret.bottom && x >= pinnedX_)
+		x = pinnedX_;
+	pinnedX_ = x;
+	pinnedLine_ = caret.bottom;
+	placePanel(*candidateWindow_, x, caret);
+}
+
+// Claudish: continue's suggestion, right after the caret (never typed into the app).
+void TextService::showGhost(Ime::EditSession* session, const std::wstring& text) {
+	RECT caret;
+	if (text.empty() || !session || !caretRect(session, &caret)) {
+		hideGhost();
+		return;
