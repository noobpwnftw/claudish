+	if (text.empty() || !session || !caretRect(session, &caret)) {
+		hideGhost();
+		return;
+	}
+	if (!ghostWindow_)
+		ghostWindow_ = std::make_unique<Ime::GhostWindow>(compositionWindow(session));
+	ghostWindow_->show(text, caret);
+}
+
+void TextService::hideGhost() {
+	if (ghostWindow_)
+		ghostWindow_->hide();
+}
