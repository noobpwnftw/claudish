+// Claudish: Composition.panel() as sent by the input method; anything missing stays empty.
+static Ime::PanelSpec panelFromJson(const json& value) {
+	Ime::PanelSpec spec;
+	if (!value.is_object())
+		return spec;
+	auto text = [&](const char* key) {
+		auto it = value.find(key);
+		return it != value.end() && it->is_string() ? utf8ToUtf16(it->get<string>().c_str()) : std::wstring();
+	};
+	spec.label = text("label");
+	spec.body = text("body");
+	spec.tail = text("tail");
+	spec.status = text("status");
+	spec.failed = text("failed");
+	if (!text("tile").empty())
+		spec.tile = text("tile");
+	auto flag = [&](const char* key) {
+		auto it = value.find(key);
+		return it != value.end() && it->is_boolean() && it->get<bool>();
+	};
+	spec.code = flag("code");
+	spec.replying = flag("replying");
+	spec.nudge = flag("nudge");
+	spec.column = flag("column");
+	auto thread = value.find("thread");
+	if (thread != value.end() && thread->is_array()) {
+		for (const auto& turn : *thread) {
+			if (!turn.is_object())
+				continue;
+			auto label = turn.find("label"), body = turn.find("body");
+			if (label != turn.end() && label->is_string() && body != turn.end() && body->is_string())
+				spec.thread.emplace_back(utf8ToUtf16(label->get<string>().c_str()), utf8ToUtf16(body->get<string>().c_str()));
+		}
+	}
+	spec.busy = flag("busy");
+	auto on = value.find("on");
+	if (on != value.end() && on->is_number_integer())
+		spec.on = on->get<int>();
+	auto rows = value.find("rows");
+	if (rows != value.end() && rows->is_array()) {
+		for (const auto& row : *rows) {
+			if (!row.is_object())
+				continue;
+			Ime::PanelRow item;
+			auto field = [&](const char* key) {
+				auto it = row.find(key);
+				return it != row.end() && it->is_string() ? utf8ToUtf16(it->get<string>().c_str()) : std::wstring();
+			};
+			item.text = field("text");
+			item.legend = field("legend");
+			spec.rows.push_back(item);
+		}
+	}
+	auto foot = value.find("foot");
+	if (foot != value.end() && foot->is_array()) {
+		for (const auto& pair : *foot) {
+			if (pair.is_array() && pair.size() == 2 && pair[0].is_string() && pair[1].is_string())
+				spec.foot.emplace_back(utf8ToUtf16(pair[0].get<string>().c_str()), utf8ToUtf16(pair[1].get<string>().c_str()));
+		}
+	}
+	return spec;
+}
