+	HWND owner = compositionWindow(session);
+	if (!ghostWindow_ || !ghostWindow_->alive(owner))  // a window of its own per owner, which may close
+		ghostWindow_ = std::make_unique<Ime::GhostWindow>(owner);
+	ghostWindow_->show(text, caret);
+}
+
+void TextService::hideGhost() {
+	if (ghostWindow_)
+		ghostWindow_->hide();
+}
