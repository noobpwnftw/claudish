+// Claudish: a panel shown briefly at the caret (a mode switch), in the message window.
+void TextService::showToast(Ime::EditSession* session, const Ime::PanelSpec& panel, int duration) {
+	hideMessage();
+	messageWindow_ = make_unique<Ime::MessageWindow>(this, session);
+	messageWindow_->setPanel(panel);
+	RECT anchor;
+	if (anchorRect(session, &anchor))
+		messageWindow_->move(anchor.left - messageWindow_->textInset(), anchor.bottom + Ime::scaled(6) - messageWindow_->topInset());
+	messageWindow_->show();
+	messageTimerId_ = ::SetTimer(messageWindow_->hwnd(), 1, duration * 1000, (TIMERPROC)TextService::onMessageTimeout);
