+void Client::updateTimer(json& msg) {
+	auto& timerVal = msg["timer"];
+	if (!timerVal.is_number_integer()) {
+		return;
+	}
+	if (timerId_) {
+		KillTimer(NULL, timerId_);
+		timers_.erase(timerId_);
+		timerId_ = 0;
+	}
+	int ms = timerVal.get<int>();
+	if (ms > 0) {
+		// A thread timer: it fires in this (the app's UI) thread, where TSF edit sessions belong.
+		timerId_ = SetTimer(NULL, 0, UINT(ms), onTimerProc);
+		if (timerId_) {
+			timers_[timerId_] = this;
+		}
+	}
+}
+
+// static
+void CALLBACK Client::onTimerProc(HWND hwnd, UINT message, UINT_PTR id, DWORD time) {
+	KillTimer(NULL, id);  // one shot: the input method asks again if it still waits
+	auto it = timers_.find(id);
+	if (it == timers_.end()) {
+		return;
+	}
+	Client* client = it->second;
+	timers_.erase(it);
+	client->timerId_ = 0;
+	client->onTimer();
+}
+
+void Client::onTimer() {
+	if (!isReady()) {
+		return;
+	}
+	auto context = textService_->currentContext();
+	if (!context) {
+		return;
+	}
+	auto session = Ime::ComPtr<Ime::EditSession>::make(context, [this](Ime::EditSession* session, TfEditCookie) {
+		json req = createRpcRequest("onTimer");
+		addSurroundingText(req, session);
+		json ret;
+		callRpcMethod(req, ret);
+		handleRpcResponse(ret, session);
+	});
+	HRESULT result;
+	context->RequestEditSession(textService_->clientId(), session, TF_ES_ASYNCDONTCARE | TF_ES_READWRITE, &result);
+}
+
+void Client::addSurroundingText(json& request, Ime::EditSession* session) {
+	if (session == nullptr) {
+		return;
+	}
+	std::wstring before, after, selected;
+	if (textService_->surroundingText(session, before, after, 1500, &selected)) {
+		request["textBefore"] = utf16ToUtf8(before.c_str());
+		request["textAfter"] = utf16ToUtf8(after.c_str());
+		request["textSelected"] = utf16ToUtf8(selected.c_str());
+	}
+	// What kind of field this is (IS_URL, IS_EMAIL_SMTPEMAILADDRESS, ...), as the app declares it.
+	request["inputScopes"] = textService_->inputScopes(session);
+	// Which text box: the TSF context, so the input method can keep one conversation per field.
+	request["document"] = std::to_string(reinterpret_cast<uintptr_t>(static_cast<ITfContext*>(session->context())));
 }
 
